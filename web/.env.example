# web/ 用の環境変数。実値は .env.local に置く（.env.local は git 管理外）

# --- DB（セッション8） -------------------------------------------------------
# ローカル: Homebrew PostgreSQL 16（createdb obfall_dev 済み）
DATABASE_URL=postgresql://USER@localhost:5432/obfall_dev
# Neon（Vercel Marketplace 連携後に発行される接続文字列。sslmode=require 付き）
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 接続方式の明示（省略時は URL のホストで自動判定: neon.tech を含めば neon、それ以外は pg）
# DB_DRIVER=pg

# --- メール（セッション9） ------------------------------------------------------
# Resend の API キー。未設定なら開発環境ではドライラン（コンソールに本文を出力）、本番では送信失敗
# RESEND_API_KEY=
# 差出人（obfall.co.jp は Resend でドメイン認証済みであること）。現行は h.katono@obfall.co.jp 固定
# CONTACT_MAIL_FROM=info@obfall.co.jp
# 会社側の受信先
# CONTACT_MAIL_TO=

# --- スパム対策: Cloudflare Turnstile（セッション9） ----------------------------
# サイトキー未設定ならウィジェットを出さない。シークレット未設定なら環境を問わず検証をスキップ（ハニーポットのみ）。2つ揃えて設定すること
# ローカル確認用（Cloudflare 公式ダミー。常に成功）:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- アプリ URL（メール内リンクの生成に使用。未設定ならリクエストのホストから組み立てる） ---
# APP_URL=https://obfall.com

# --- 管理者向けメール（セッション11: PW 再設定2通。HTML） -------------------------
# 差出人（未設定なら CONTACT_MAIL_FROM を使う）。現行は Laravel の MAIL_FROM_ADDRESS（本番値未確認）
# OFFICE_MAIL_FROM=
# 差出人表示名（未設定なら「OBFall株式会社」）。現行は MAIL_FROM_NAME=${APP_NAME}
# MAIL_FROM_NAME=

# --- 管理画面 認証: Auth.js（セッション10） ---------------------------------------
# セッション Cookie（JWT）の署名鍵。`openssl rand -base64 32` で生成。環境ごとに別の値にする
AUTH_SECRET=
# Vercel 以外で動かすときにホストを信頼する（コード側でも trustHost: true にしているため通常は不要）
# AUTH_TRUST_HOST=true

# --- 画像ストレージ: Vercel Blob（セッション12） ---------------------------------
# Vercel の Storage で Blob を接続すると自動で入る。未設定なら開発環境では web/public/uploads/ に保存（git 管理外）、本番では保存失敗
# BLOB_READ_WRITE_TOKEN=
